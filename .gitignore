# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Raw phone captures. Only the optimised copies in assets/projects/ are needed
# to build the site, and these originals are ~19 MB — enough to slow every
# clone and CI checkout. Keep your own backup of this folder.
/screenshots_src/

# .mcp.json is tracked on purpose: the 21st CLI writes the API key as a
# ${API_KEY_21ST} reference rather than a literal, so the file holds no secret.
# The key itself lives only in the user environment variable.
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
